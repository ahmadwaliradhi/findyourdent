  "rules": [
    {
      "all": ["difficulty_breathing"],
      "reason": {
        "id": "Sulit bernapas bersama keluhan gigi bisa berarti infeksi atau bengkak menekan jalan napas.",
        "en": "Difficulty breathing with a dental problem can mean infection or swelling is pressing on the airway."
      }
    },
    {
      "all": ["difficulty_swallowing"],
      "reason": {
        "id": "Sulit menelan bersama keluhan gigi bisa berarti infeksi sudah menyebar ke tenggorokan.",
        "en": "Difficulty swallowing with a dental problem can mean an infection has spread to the throat."
      }
    },
    {
      "all": ["facial_or_neck_swelling", "fever"],
      "reason": {
        "id": "Bengkak di wajah atau leher disertai demam bisa berarti infeksi yang menyebar.",
        "en": "Swelling of the face or neck with a fever can mean an infection is spreading."
      }
    },
    {
      "all": ["trismus"],
      "reason": {
        "id": "Mulut yang sulit dibuka bisa berarti infeksi sudah menyebar ke otot rahang.",
        "en": "Being unable to open your mouth can mean an infection has spread to the jaw muscles."
      }
    },
    {
      "all": ["uncontrolled_bleeding"],
      "reason": {
        "id": "Perdarahan dari mulut yang tidak berhenti perlu dihentikan oleh tenaga medis sekarang.",
        "en": "Bleeding from the mouth that will not stop needs medical care now."
      }
    },
    {
      "all": ["knocked_out_permanent_tooth"],
      "reason": {
        "id": "Gigi dewasa yang copot karena benturan paling mungkin diselamatkan bila ditangani dalam satu jam.",
        "en": "An adult tooth knocked out in an accident is most likely to be saved if treated within an hour."
      }
    }
  ]
