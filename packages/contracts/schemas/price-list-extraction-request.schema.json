{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findyourdent.com/schemas/price-list-extraction-request.schema.json",
  "title": "PriceListExtractionRequest",
  "description": "Web service to agent service: one PDF or up to five images of a claimed Provider's price list (spec 05).",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [{ "required": ["pdf"] }, { "required": ["images"] }],
  "properties": {
    "pdf": {
      "title": "PriceListPdf",
      "type": "object",
      "additionalProperties": false,
      "required": ["mimeType", "dataBase64"],
      "properties": {
        "mimeType": { "const": "application/pdf" },
        "dataBase64": { "type": "string", "minLength": 1 }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "title": "PriceListImage",
        "type": "object",
        "additionalProperties": false,
        "required": ["mimeType", "dataBase64"],
        "properties": {
          "mimeType": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp"] },
          "dataBase64": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
