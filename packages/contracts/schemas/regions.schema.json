{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findyourdent.com/schemas/regions.schema.json",
  "title": "RegionList",
  "description": "Shape of data/regions.json: Kemendagri administrative region codes (province NN, kabupaten/kota NN.NN). Kecamatan (NN.NN.NN) are not shipped yet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "version", "complete", "notes", "provinces", "regencies"],
  "properties": {
    "$schema": { "type": "string" },
    "source": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "complete": {
      "description": "True only when every province has regenciesComplete true and the list was checked against the official annex.",
      "type": "boolean"
    },
    "notes": { "type": "string" },
    "provinces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Province" }
    },
    "regencies": {
      "description": "Kabupaten and kota.",
      "type": "array",
      "items": { "$ref": "#/$defs/Regency" }
    }
  },
  "$defs": {
    "Province": {
      "title": "Province",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "regenciesComplete"],
      "properties": {
        "code": { "type": "string", "pattern": "^[0-9]{2}$" },
        "name": { "type": "string", "minLength": 1 },
        "regenciesComplete": {
          "description": "Whether every kabupaten/kota of this province is in regencies.",
          "type": "boolean"
        }
      }
    },
    "Regency": {
      "title": "Regency",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "provinceCode", "type", "name"],
      "properties": {
        "code": { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}$" },
        "provinceCode": { "type": "string", "pattern": "^[0-9]{2}$" },
        "type": { "type": "string", "enum": ["kabupaten", "kota"] },
        "name": {
          "description": "Official name including the Kabupaten/Kota prefix.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
