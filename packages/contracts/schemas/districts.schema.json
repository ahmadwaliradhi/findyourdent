{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findyourdent.com/schemas/districts.schema.json",
  "title": "DistrictList",
  "description": "Shape of data/districts.json: Kemendagri kecamatan codes (NN.NN.NN), each under a kabupaten/kota of data/regions.json. Kept apart from regions.json so pages that only need provinces and kota/kabupaten do not ship every kecamatan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "retrievedFrom", "retrievedOn", "notes", "districts"],
  "properties": {
    "$schema": { "type": "string" },
    "source": {
      "description": "The official list the codes and names come from.",
      "type": "string",
      "minLength": 1
    },
    "retrievedFrom": {
      "description": "Where this copy of the list was downloaded.",
      "type": "string",
      "format": "uri"
    },
    "retrievedOn": {
      "description": "Download date, YYYY-MM-DD.",
      "type": "string",
      "format": "date"
    },
    "notes": { "type": "string" },
    "districts": {
      "description": "Kecamatan, in code order.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/District" }
    }
  },
  "$defs": {
    "District": {
      "title": "District",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "regencyCode", "name"],
      "properties": {
        "code": { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}$" },
        "regencyCode": { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}$" },
        "name": {
          "description": "Official kecamatan name, without a Kecamatan prefix.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
