# Copy to .env for local overrides (never commit .env).
PORT=3000
# Agent service base URL (services/agent). Set AGENT_ADAPTER=fake to run the web app without it.
AGENT_URL=http://localhost:8000
AGENT_ADAPTER=http
# id_token on Cloud Run: sign agent calls with the service account's identity token.
AGENT_AUTH=none
# Signs shareable Guidance links. Unset locally = a new random secret per process.
# SHARE_LINK_SECRET=
# Set to use the Firebase emulators (firebase emulators:start from the repo root).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
GCLOUD_PROJECT=demo-findyourdent

# Sign-in and App Check (public values; see infra/gcp/README.md).
# FIREBASE_WEB_API_KEY=
# FIREBASE_WEB_APP_ID=1:1001413011907:web:d59beb8fb53f70f21d3576
# RECAPTCHA_SITE_KEY=6LeFCfMtAAAAACLP7NiG2xaEClvTnRY5qqTPFdxC
# Outside production, the one App Check token the server accepts; the page sends it
# instead of calling reCAPTCHA. Without it (and without Firebase) paid routes refuse.
APP_CHECK_DEBUG_TOKEN=local-app-check-debug-token
# Admin allowlist, comma-separated (production reads the admin-emails secret).
# ADMIN_EMAILS=
# Secret salt for rate-limit key hashes; set in production so every instance shares counters.
# RATE_LIMIT_SALT=
# Rate-limit overrides (defaults from spec 00).
# RATE_LIMIT_GUIDANCE_PER_HOUR=10
# RATE_LIMIT_PLACES_PER_HOUR=30
# RATE_LIMIT_TESTIMONIES_PER_DAY=5
# RATE_LIMIT_IP_PER_HOUR=300
