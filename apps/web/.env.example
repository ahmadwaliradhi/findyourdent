# Copy to .env for local overrides (never commit .env).
PORT=3000
# Agent service base URL (services/agent). Set AGENT_ADAPTER=fake to run the web app without it.
AGENT_URL=http://localhost:8000
AGENT_ADAPTER=http
# Set to use the Firebase emulators (firebase emulators:start from the repo root).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
GCLOUD_PROJECT=demo-findyourdent
