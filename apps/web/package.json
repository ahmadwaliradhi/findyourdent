{
  "name": "web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server.ts",
    "build": "react-router build",
    "start": "NODE_ENV=production node server.ts",
    "typecheck": "react-router typegen && tsc",
    "test": "firebase emulators:exec --config ../../firebase.json --project demo-findyourdent --only firestore,auth,storage \"vitest run\"",
    "test:unit": "vitest run --project unit",
    "test:e2e": "playwright test",
    "lighthouse": "react-router build && npx -y @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "@findyourdent/contracts": "workspace:*",
    "@react-router/express": "7.18.4",
    "@react-router/node": "7.18.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "compression": "1.8.2",
    "express": "5.3.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "i18next": "26.4.6",
    "isbot": "5.2.2",
    "lucide-react": "1.48.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.18",
    "react-router": "7.18.4",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-tools": "15.34.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
