{
  "name": "findyourdent",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:agent": "uv run --directory services/agent agent-dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "contracts:generate": "pnpm --filter @findyourdent/contracts generate && uv run --directory services/agent python scripts/generate_contracts.py",
    "contracts:check": "pnpm --filter @findyourdent/contracts check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
